# Domain-role grant step env template (deploy step 2, see deploy/README.md).
# Copy to deploy/grants.env on <app-host> and fill in the private references.
# Contains NO secret values: only secret-manager references and non-secret config.
# Resolved at runtime by:  op run --env-file=deploy/grants.env -- sh -c 'psql ...'
#
# psql reads the migration-owner connection from these standard libpq
# environment variables, so no credential appears on the command line (where
# other users could read it from /proc/<pid>/cmdline). Do NOT pass
# MIGRATION_DATABASE_URL to psql as an argument.

PGHOST="<managed-db-host>"
PGPORT="5432"
PGDATABASE="<database-name>"
PGUSER="<migration-owner-role>"
PGPASSWORD="<secret-manager-ref>"
PGSSLMODE="require"

# The role name in DATABASE_URL (the domain runtime role). It is a name, not a secret.
DOMAIN_DB_ROLE="<domain-runtime-role>"
